# =============================================================================
# TAJI TOKRI: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit real secret keys to version control.
# =============================================================================

# 1. Supabase Connection (Public & Server-Side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Application Base URL
NEXT_PUBLIC_APP_URL=https://tajitokri.store

# 3. Internal Automation & Webhook Security
INTERNAL_API_SECRET=your-internal-worker-secret-token

# 4. Meta WhatsApp Cloud API (Optional - can also be configured in n8n / app_settings)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token

# 5. Future Online Payment Gateway (Disabled for MVP)
RAZORPAY_KEY_ID=your-razorpay-key-id-placeholder
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-placeholder
